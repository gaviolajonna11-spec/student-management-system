<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.test_student_management.controller.AuthController"
      stylesheets="@/style.css">

    <!-- LEFT BRAND PANEL -->
    <VBox alignment="CENTER"
          spacing="18"
          prefWidth="320"
          styleClass="auth-left-panel">

        <ImageView fitWidth="120" fitHeight="120">
            <image>
                <Image url="@/PUP-LOGO.png"/>
            </image>
        </ImageView>

        <Label text="Student Management System"
               wrapText="true"
               styleClass="auth-system-title"/>

        <Label text="Polytechnic University of the Philippines"
               wrapText="true"
               styleClass="auth-subtitle"/>

    </VBox>

    <!-- RIGHT LOGIN PANEL -->
    <VBox alignment="CENTER"
          spacing="18"
          HBox.hgrow="ALWAYS"
          styleClass="auth-right-panel">

        <VBox spacing="5" alignment="CENTER">

            <Label text="Welcome Back"
                   styleClass="auth-title"/>

            <Label text="Login to continue"
                   styleClass="auth-description"/>

        </VBox>

        <VBox spacing="12"
              maxWidth="320"
              styleClass="login-card">

            <TextField fx:id="usernameField"
                       promptText="Username"
                       styleClass="modern-field"/>

            <PasswordField fx:id="passwordField"
                           promptText="Password"
                           styleClass="modern-field"/>

            <Button text="Sign In"
                    onAction="#handleLogin"
                    maxWidth="Infinity"
                    styleClass="primary-button"/>

            <Button text="Create Account"
                    onAction="#handleOpenSignUp"
                    maxWidth="Infinity"
                    styleClass="secondary-button"/>

        </VBox>

    </VBox>

</HBox>